datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Roles ────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isAdmin     Boolean  @default(false) @map("is_admin")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions Permission[]

  @@map("roles")
}

// ── Users ────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  username  String   @unique
  password  String
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  presentations Presentation[]
  apiKeys       ApiKey[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ── Permissions ──────────────────────────────────────

model Permission {
  id       String @id @default(uuid())
  resource String
  action   String
  roleId   String @map("role_id")
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([resource, action, roleId])
  @@map("permissions")
}

model PublicResource {
  id       String @id @default(uuid())
  resource String @unique

  @@map("public_resources")
}

// ── CMS Content ──────────────────────────────────────

model CmsPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cms_pages")
}

model Live {
  id           String   @id @default(uuid())
  label        String   @default("PRÓXIMA ETAPA DO PIPELINE")
  title        String
  description  String
  buttonText   String   @default("Entrar na Live") @map("button_text")
  // CTA label shown before the event starts (after start, `buttonText` is used).
  buttonTextBefore String @default("Ativar lembrete") @map("button_text_before")
  buttonUrl    String   @default("#") @map("button_url")
  thumbnailUrl String?  @map("thumbnail_url")
  isLive       Boolean  @default(false) @map("is_live")
  // Whether the live section is rendered on the landing at all. Lets the admin
  // hide the whole section without deleting its content.
  isVisible    Boolean  @default(true) @map("is_visible")
  viewersCount String   @default("0") @map("viewers_count")
  // Absolute UTC instant the live event starts. The landing derives its "live"
  // status from this: the badge shows once `occursAt` is in the past.
  occursAt     DateTime? @map("occurs_at")
  // IANA timezone (e.g. "America/Sao_Paulo") the admin picked the date/time in.
  // Kept only so the CMS can re-render the local wall-clock time when editing.
  occursAtTimezone String? @map("occurs_at_timezone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("lives")
}

model Episode {
  id        String   @id @default(uuid())
  module    String
  title     String
  duration  String
  imageUrl  String?  @map("image_url")
  // Where the episode card on the landing points to. Generic on purpose: it is
  // a YouTube link today, but nothing here assumes that.
  videoUrl  String?  @map("video_url")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("episodes")
}

// Hero section at the top of the landing page. Singleton, like Live: at most
// one row, edited from the "Hero Section" content CMS page.
model HeroSection {
  id         String   @id @default(uuid())
  title      String   @default("Construindo a maior escola mobile do zero")
  subtitle   String   @default("Acompanhe os bastidores técnicos reais através da nossa jornada Build in Public no YouTube. Aprenda engenharia de software de verdade, vendo como as coisas são feitas na prática.")
  buttonText String   @default("Acompanhar no YouTube") @map("button_text")
  buttonUrl  String   @default("#") @map("button_url")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("hero_section")
}

// "A Escola do Futuro" about section on the landing. Singleton, like Live: at
// most one row, edited from the "About Section" content CMS page. The body is
// stored as plain text; blank lines separate paragraphs when rendered. The two
// stat cards are a fixed pair (value + label each).
model AboutSection {
  id         String   @id @default(uuid())
  title      String   @default("A Escola do Futuro")
  body       String
  stat1Value String   @default("100+") @map("stat1_value")
  stat1Label String   @default("Horas de Live") @map("stat1_label")
  stat2Value String   @default("15k") @map("stat2_value")
  stat2Label String   @default("Devs Ativos") @map("stat2_label")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("about_section")
}

// Footer of the landing page. Singleton, like HeroSection: at most one row,
// edited from the "Footer" content CMS page. Holds the visibility switches for
// the footer blocks whose content is not CMS-managed elsewhere.
model FooterSection {
  id                String   @id @default(uuid())
  // The newsletter widget advertises a signup flow that does not exist yet, so
  // it starts hidden and an admin has to opt into showing it.
  newsletterEnabled Boolean  @default(false) @map("newsletter_enabled")
  // The social block already has real content, so it starts visible. The
  // landing still omits it when no link is configured.
  socialLinksEnabled Boolean @default(true) @map("social_links_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("footer_section")
}

// One entry of the "Social" list in the footer. Ordered like Episode, through
// an explicit `order` column the CMS rewrites when the admin moves a row.
model SocialLink {
  id        String   @id @default(uuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_links")
}

// CTA rendered under the episodes list on the landing ("Ver todos episódios").
// Singleton, like Live: at most one row, edited from the episodes CMS page.
model EpisodesButton {
  id        String   @id @default(uuid())
  text      String   @default("Ver todos episódios")
  url       String   @default("#")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("episodes_button")
}

// ── Presentations ────────────────────────────────────

enum PresentationVisibility {
  PUBLIC
  PRIVATE
  // Modelled only: behaves as PRIVATE until the members area exists.
  MEMBERS
}

// A slide deck. Slides are built from the templates in @repo/slides; the
// backend validates every slide write against them.
model Presentation {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  title       String
  description String?
  visibility  PresentationVisibility @default(PRIVATE)
  createdById String                 @map("created_by_id")
  createdBy   User                   @relation(fields: [createdById], references: [id])
  // Soft delete: set by deletePresentation, which API keys can also call. Only
  // purgePresentation, which requires a logged-in user, removes the row.
  deletedAt   DateTime?              @map("deleted_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  slides      Slide[]

  @@map("presentations")
}

model Slide {
  id             String       @id @default(uuid())
  presentationId String       @map("presentation_id")
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  // Rewritten in a transaction on every reorder, like Episode and SocialLink.
  order          Int          @default(0)
  // Template key from @repo/slides. A string, not an enum, so adding a
  // template needs no migration; the registry rejects unknown keys on write.
  template       String
  content        Json
  notes          String       @default("")
  hidden         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([presentationId, order])
  @@map("slides")
}

// Short-lived bearer token for external agents (e.g. Claude) to manage
// presentations. Only the SHA-256 of the token is stored.
model ApiKey {
  id          String    @id @default(uuid())
  name        String
  // First 8 characters after "ei_", shown in the CMS list.
  prefix      String
  hash        String    @unique
  createdById String    @map("created_by_id")
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}
